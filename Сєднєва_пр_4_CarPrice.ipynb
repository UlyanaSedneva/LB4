        "# і виправляємо помилки в написанні марок, які є в датасеті\n",
        "cars['brand'] = cars['CarName'].str.split().str[0].str.lower()\n",
        "print('Марки до виправлення:', sorted(cars['brand'].unique()), '\\n')\n",
        "cars['brand'] = cars['brand'].replace({'maxda': 'mazda', 'porcshce': 'porsche', 'toyouta': 'toyota',\n",
