        "X = cars_enc.drop(columns=['car_ID', 'price'])\n",
        "y = cars_enc['price']            # ln(1 + ціна)\n",
        "ids = cars_enc['car_ID']\n",
        "\n",
        "X_train, X_test, y_train, y_test, id_train, id_test = train_test_split(\n",
        "    X, y, ids, test_size=0.2, random_state=RANDOM_STATE)\n",
        "print('Тренувальні дані:', X_train.shape, ' Тестові дані:', X_test.shape)"
      ]
