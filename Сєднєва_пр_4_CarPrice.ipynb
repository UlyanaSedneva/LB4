      "source": [
        "# Метрики рахуємо в доларах: прогноз ln(1 + ціна) переводимо назад через expm1\n",
        "y_test_usd = pd.Series(from_price(y_test), index=y_test.index)\n",
        "preds = {name: from_price(m.predict(X_test)) for name, m in models.items()}\n",
        "\n",
        "rows = {}\n",
        "for name, m in models.items():\n",
        "    p = preds[name]\n",
        "    rows[name] = {\n",
        "        'R2 (тест)': r2_score(y_test_usd, p),\n",
        "        'MAE, $': mean_absolute_error(y_test_usd, p),\n",
        "        'RMSE, $': np.sqrt(mean_squared_error(y_test_usd, p)),\n",
        "        'MAPE, %': mean_absolute_percentage_error(y_test_usd, p) * 100,\n",
        "        'R2 (CV, ln ціни)': cross_val_score(m, X_train, y_train, cv=cv5, scoring='r2').mean(),\n",
        "        'R2 (тренування)': r2_score(from_price(y_train), from_price(m.predict(X_train))),\n",
        "    }\n",
        "metrics = pd.DataFrame(rows).T.sort_values('R2 (тест)', ascending=False)\n",
        "display(metrics)\n",
        "print(f\"Найкраща модель на тесті: {metrics.index[0]} (R2 = {metrics.iloc[0]['R2 (тест)']:.3f}, \"\n",
        "      f\"середня похибка {metrics.iloc[0]['MAE, $']:,.0f} $)\")\n",
        "print(f'Середня ціна авто в тестовій вибірці: {y_test_usd.mean():,.0f} $')"
      ]
    },
