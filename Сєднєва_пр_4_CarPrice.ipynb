      "source": [
        "## 7. Кодування категоріальних ознак"
      ]
    },
    {
      "cell_type": "code",
      "id": "c19",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c19",
        "outputId": "929dbb65-86e9-4f60-a8c3-c486843845e0"
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Категоріальні ознаки та кількість значень:\n",
            "fueltype           2\n",
            "aspiration         2\n",
            "doornumber         2\n",
            "carbody            5\n",
            "drivewheel         3\n",
            "enginelocation     2\n",
            "enginetype         6\n",
            "cylindernumber     6\n",
            "fuelsystem         8\n",
            "brand             22\n",
            "dtype: int64\n",
            "\n",
            "Розмір після кодування: (198, 57)\n",
            "Нечислових стовпців не залишилось: True\n"
          ]
        }
      ],
      "source": [
        "cat_cols = list(cars.select_dtypes(exclude='number').columns)\n",
        "print('Категоріальні ознаки та кількість значень:')\n",
        "print(cars[cat_cols].nunique())\n",
        "\n",
        "# Бінарні ознаки -> 0/1\n",
        "binary_map = {'fueltype': {'gas': 0, 'diesel': 1}, 'aspiration': {'std': 0, 'turbo': 1},\n",
        "              'doornumber': {'two': 0, 'four': 1}, 'enginelocation': {'front': 0, 'rear': 1}}\n",
        "for col, mapping in binary_map.items():\n",
        "    cars[col] = cars[col].map(mapping)\n",
        "\n",
        "# Кількість циліндрів записана словами - це порядкова ознака, переводимо в число\n",
        "cars['cylindernumber'] = cars['cylindernumber'].map(\n",
        "    {'two': 2, 'three': 3, 'four': 4, 'five': 5, 'six': 6, 'eight': 8, 'twelve': 12})\n",
        "\n",
        "# Решта (номінальні) -> one-hot кодування; drop_first прибирає надлишковий стовпець\n",
        "nominal = ['carbody', 'drivewheel', 'enginetype', 'fuelsystem', 'brand']\n",
        "cars_enc = pd.get_dummies(cars, columns=nominal, drop_first=True, dtype=int)\n",
        "print('\\nРозмір після кодування:', cars_enc.shape)\n",
        "print('Нечислових стовпців не залишилось:', cars_enc.select_dtypes(exclude='number').shape[1] == 0)"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "c20",
      "metadata": {
        "id": "c20"
      },
      "source": [
        "## 8. Поділ на тренувальні і тестові дані"
      ]
    },
    {
      "cell_type": "code",
      "id": "c21",
      "metadata": {
        "colab": {
