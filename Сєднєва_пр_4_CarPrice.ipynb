        "# Видалення аномальних значень.\n",
        "# Датасет малий (205 авто), тому видаляємо лише ЕКСТРЕМАЛЬНІ викиди (за межами 3·IQR).\n",
        "# compressionratio не враховуємо: високі значення там - це звичайні дизельні двигуни, а не аномалії.\n",
        "check_cols = [c for c in num_cols if c != 'compressionratio']\n",
        "anomaly = extreme[check_cols].any(axis=1)\n",
        "print('Видаляються як аномальні:')\n",
        "display(cars.loc[anomaly, ['car_ID', 'brand', 'cylindernumber', 'enginesize', 'horsepower', 'stroke', 'price']])\n",
        "\n",
        "cars = cars[~anomaly].reset_index(drop=True)\n",
        "print(f'Видалено рядків: {anomaly.sum()} ({anomaly.mean() * 100:.1f} %). Залишилось: {len(cars)}')"
      ]
    },
