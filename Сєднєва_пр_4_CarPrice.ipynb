      "source": [
        "# Числові ознаки (car_ID - лише номер запису, symboling - ординальний рейтинг ризику від -2 до 3)\n",
        "num_cols = [c for c in cars.select_dtypes('number').columns if c not in ('car_ID', 'symboling')]\n",
        "\n",
        "def skew_label(s):\n",
        "    a = abs(s)\n",
        "    return 'симетричний' if a < 0.5 else ('помірна асиметрія' if a < 1 else 'сильна асиметрія')\n",
        "\n",
        "skew_before = cars[num_cols].skew().sort_values(ascending=False)\n",
        "display(pd.DataFrame({'Коефіцієнт асиметрії': skew_before, 'Висновок': skew_before.map(skew_label)}))\n",
        "\n",
        "fig, axes = plt.subplots(3, 5, figsize=(18, 10))\n",
        "for ax, col in zip(axes.ravel(), num_cols):\n",
        "    sns.histplot(cars[col], kde=True, ax=ax, color='steelblue')\n",
        "    ax.set_title(f'{col} (skew = {cars[col].skew():.2f})')\n",
        "    ax.set_xlabel('')\n",
        "for ax in axes.ravel()[len(num_cols):]:\n",
        "    ax.axis('off')\n",
        "plt.suptitle('Розподіли числових ознак', fontsize=14)\n",
        "plt.tight_layout(); plt.show()"
      ]
    },
