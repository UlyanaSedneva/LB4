      "source": [
        "# Ознаки з помітною асиметрією (|skew| > 0.75) перетворюємо методом Бокса-Кокса:\n",
        "# він сам підбирає степінь lambda, за якої розподіл стає найближчим до симетричного\n",
        "# (lambda = 0 відповідає логарифму). Усі ознаки додатні, тому метод застосовний.\n",
        "# Моделі навчаються на перетвореній ціні, а прогноз переводиться назад у долари.\n",
        "from scipy.stats import boxcox\n",
        "\n",
        "skew_now = cars[num_cols].skew()\n",
        "bc_cols = [c for c in skew_now[skew_now.abs() > 0.75].index if c != 'price']\n",
        "print('Перетворення Бокса-Кокса:', bc_cols)\n",
        "\n",
        "lambdas = {}\n",
        "for c in bc_cols:\n",
        "    cars[c], lambdas[c] = boxcox(cars[c])\n",
        "price_usd = cars['price'].copy()\n",
        "# Для ціни Бокс-Кокс дає від'ємне lambda (~ -0.6), а таке перетворення має верхню межу:\n",
        "# якщо модель спрогнозує значення біля неї, обернене перетворення дасть нескінченну ціну.\n",
        "# Тому ціну логарифмуємо - логарифм теж прибирає більшу частину асиметрії і обертається без обмежень.\n",
        "cars['price'] = np.log1p(cars['price'])\n",
        "def from_price(v):\n",
        "    \"\"\"ln(1 + ціна) -> ціна в доларах\"\"\"\n",
        "    return np.expm1(np.asarray(v))\n",
        "\n",
        "changed = bc_cols + ['price']\n",
        "skew_after = cars[num_cols].skew()\n",
        "display(pd.DataFrame({'Асиметрія до': skew_now[changed], 'Асиметрія після': skew_after[changed],\n",
        "                      'lambda': pd.Series(lambdas)}).round(3))\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
        "sns.histplot(price_usd, kde=True, ax=axes[0], color='tomato')\n",
        "axes[0].set_title(f\"price до перетворення (skew = {skew_now['price']:.2f})\")\n",
        "sns.histplot(cars['price'], kde=True, ax=axes[1], color='seagreen')\n",
        "axes[1].set_title(f\"ln(1 + price) (skew = {skew_after['price']:.2f})\")\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# Примітка: у compressionratio коефіцієнт асиметрії став ~0, але розподіл лишився з двома \"горбами\"\n",
        "# (бензинові двигуни ~9, дизельні ~22) - це дві групи авто, яку різницю також враховує ознака fueltype"
      ]
    },
