      "source": [
        "## 9. Регресійні моделі\n",
        "\n",
        "Лінійним моделям і методу опорних векторів потрібні масштабовані ознаки, тому вони працюють у конвеєрі зі `StandardScaler`. Масштабувальник навчається лише на тренувальних даних. Параметри регуляризації (Ridge, Lasso), SVR та ансамблів підібрано за допомогою GridSearchCV з 5-блочною крос-валідацією."
      ]
    },
    {
      "cell_type": "code",
      "id": "c23",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c23",
        "outputId": "857afbba-3945-42cf-8b90-9cc45b6144a8"
      },
      "execution_count": 14,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Лінійна регресія: без гіперпараметрів\n",
            "Ridge: найкращі параметри {'ridge__alpha': 10}\n",
            "Lasso: найкращі параметри {'lasso__alpha': 0.001}\n",
            "Випадковий ліс: найкращі параметри {'max_depth': 8, 'max_features': 1.0, 'n_estimators': 300}\n",
            "Градієнтний бустинг: найкращі параметри {'learning_rate': 0.05, 'max_depth': 3, 'n_estimators': 400}\n",
            "SVR (опорні вектори): найкращі параметри {'svr__C': 10, 'svr__epsilon': 0.05, 'svr__gamma': 0.003}\n",
            "\n",
            "Lasso обнулила 9 з 55 коефіцієнтів (автоматичний відбір ознак)\n"
          ]
        }
      ],
      "source": [
        "cv5 = KFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
        "candidates = {\n",
        "    'Лінійна регресія': (make_pipeline(StandardScaler(), LinearRegression()), {}),\n",
        "    'Ridge': (make_pipeline(StandardScaler(), Ridge()), {'ridge__alpha': [0.1, 1, 3, 10, 30, 100]}),\n",
        "    'Lasso': (make_pipeline(StandardScaler(), Lasso(max_iter=50000)),\n",
        "              {'lasso__alpha': [0.0005, 0.001, 0.003, 0.01, 0.03, 0.1]}),\n",
        "    'Випадковий ліс': (RandomForestRegressor(random_state=RANDOM_STATE, n_jobs=-1),\n",
        "                       {'n_estimators': [300], 'max_depth': [None, 8], 'max_features': [0.33, 0.5, 1.0]}),\n",
        "    'Градієнтний бустинг': (GradientBoostingRegressor(random_state=RANDOM_STATE),\n",
        "                            {'n_estimators': [200, 400], 'learning_rate': [0.05, 0.1], 'max_depth': [2, 3]}),\n",
        "    'SVR (опорні вектори)': (make_pipeline(StandardScaler(), SVR()),\n",
        "                             {'svr__C': [1, 3, 10, 30], 'svr__epsilon': [0.01, 0.05, 0.1],\n",
        "                              'svr__gamma': ['scale', 0.003, 0.01]}),\n",
        "}\n",
        "\n",
        "models = {}\n",
        "for name, (est, grid) in candidates.items():\n",
        "    if grid:\n",
        "        gs = GridSearchCV(est, grid, cv=cv5, scoring='r2', n_jobs=-1).fit(X_train, y_train)\n",
        "        models[name] = gs.best_estimator_\n",
        "        print(f'{name}: найкращі параметри {gs.best_params_}')\n",
        "    else:\n",
        "        models[name] = est.fit(X_train, y_train)\n",
        "        print(f'{name}: без гіперпараметрів')\n",
        "\n",
        "lasso = models['Lasso'][-1]\n",
        "print(f'\\nLasso обнулила {np.sum(lasso.coef_ == 0)} з {len(lasso.coef_)} коефіцієнтів (автоматичний відбір ознак)')"
      ]
    },
