      "source": [
        "# Беремо 10 випадкових ID з ТЕСТОВОЇ вибірки, щоб модель не бачила ці авто під час навчання\n",
        "sample_ids = id_test.sample(10, random_state=RANDOM_STATE)\n",
        "X_sample = X_test.loc[sample_ids.index]\n",
        "forecast = pd.DataFrame({\n",
        "    'car_ID': sample_ids.values,\n",
        "    'Марка': cars.loc[sample_ids.index, 'brand'].values,\n",
        "    'Справжня ціна, $': from_price(y_test.loc[sample_ids.index]).round(0),\n",
        "    'Прогноз RF, $': from_price(rf.predict(X_sample)).round(0),\n",
        "})\n",
        "forecast['Похибка, $'] = forecast['Прогноз RF, $'] - forecast['Справжня ціна, $']\n",
        "forecast['Похибка, %'] = (forecast['Похибка, $'] / forecast['Справжня ціна, $'] * 100).round(1)\n",
        "display(forecast.sort_values('car_ID').reset_index(drop=True))\n",
        "print(f\"Середня абсолютна похибка для цих 10 авто: {forecast['Похибка, %'].abs().mean():.1f} %\")"
      ]
