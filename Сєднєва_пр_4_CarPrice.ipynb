          ]
        }
      ],
      "source": [
        "# Пари ОЗНАК з |r| > 0.85 (ціну не чіпаємо - це цільова змінна).\n",
        "# З кожної пари видаляємо ту ознаку, яка слабше корелює з ціною.\n",
        "feat_corr = cars[[c for c in num_cols if c != 'price']].corr()\n",
        "pairs = (feat_corr.where(np.triu(np.ones(feat_corr.shape, dtype=bool), k=1))\n",
        "         .stack().loc[lambda s: s.abs() > 0.85].sort_values(key=abs, ascending=False))\n",
        "print('Пари ознак з |r| > 0.85:')\n",
        "print(pairs.round(3))\n",
        "\n",
        "to_drop = set()\n",
        "for (a, b), r in pairs.items():\n",
        "    if a in to_drop or b in to_drop:\n",
        "        continue                      # пара вже \"розв'язана\" видаленням однієї з ознак\n",
        "    weaker = a if abs(corr_price[a]) < abs(corr_price[b]) else b\n",
        "    to_drop.add(weaker)\n",
        "    print(f'{a} - {b} (r = {r:.3f}): видаляємо {weaker} (|r з ціною| = {abs(corr_price[weaker]):.3f})')\n",
        "\n",
        "cars = cars.drop(columns=list(to_drop))\n",
        "num_cols = [c for c in num_cols if c not in to_drop]\n",
        "print('\\nВидалені ознаки:', sorted(to_drop))"
      ]
    },
