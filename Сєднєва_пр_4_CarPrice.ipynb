      "source": [
        "# Викиди за правилом міжквартильного розмаху (IQR)\n",
        "Q1, Q3 = cars[num_cols].quantile(0.25), cars[num_cols].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "mild = ((cars[num_cols] < Q1 - 1.5 * IQR) | (cars[num_cols] > Q3 + 1.5 * IQR))\n",
        "extreme = ((cars[num_cols] < Q1 - 3 * IQR) | (cars[num_cols] > Q3 + 3 * IQR))\n",
        "display(pd.DataFrame({'Викиди (1.5·IQR)': mild.sum(), 'Екстремальні (3·IQR)': extreme.sum()}))\n",
        "\n",
        "fig, axes = plt.subplots(3, 5, figsize=(18, 9))\n",
        "for ax, col in zip(axes.ravel(), num_cols):\n",
        "    sns.boxplot(x=cars[col], ax=ax, color='lightsteelblue')\n",
        "    ax.set_title(col); ax.set_xlabel('')\n",
        "for ax in axes.ravel()[len(num_cols):]:\n",
        "    ax.axis('off')\n",
        "plt.suptitle('Діаграми розмаху (boxplot)', fontsize=14)\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# compressionratio: \"викиди\" - це всі дизельні авто (у дизеля ступінь стиснення 20-23, у бензинових 7-11)\n",
        "print('Паливо в авто з compressionratio > 15:', cars.loc[cars['compressionratio'] > 15, 'fueltype'].value_counts().to_dict())"
      ]
    },
