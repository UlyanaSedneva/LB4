        "# Прогноз проти справжньої ціни для кожної моделі\n",
        "fig, axes = plt.subplots(2, 3, figsize=(17, 10))\n",
        "lim = [0, max(y_test_usd.max(), max(p.max() for p in preds.values())) * 1.05]\n",
        "for ax, name in zip(axes.ravel(), metrics.index):\n",
        "    ax.scatter(y_test_usd, preds[name], alpha=0.7, edgecolor='k')\n",
        "    ax.plot(lim, lim, 'r--', label='Ідеальний прогноз')\n",
        "    ax.set_xlim(lim); ax.set_ylim(lim)\n",
        "    ax.set_xlabel('Справжня ціна, $'); ax.set_ylabel('Прогнозована ціна, $')\n",
